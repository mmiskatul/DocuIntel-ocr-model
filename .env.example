# ==============================================================================
# DocuIntel OCR, Vectorization & Multi-LLM Service Configuration (.env.example)
# ==============================================================================
PORT=7860

# --- Your AI Provider API Keys ---
# 1. OpenAI (GPT-4o, GPT-4o-mini & text-embedding-3-small)
OPENAI_API_KEY=your-openai-api-key

# 2. Anthropic (Claude 3.5 Sonnet / Claude 3.5 Haiku)
ANTHROPIC_API_KEY=your-anthropic-api-key

# 3. DeepSeek (DeepSeek-V3 / DeepSeek-Chat)
DEEPSEEK_API_KEY=your-deepseek-api-key

# 4. Grok (xAI Grok-2 / Grok-beta)
XAI_API_KEY=your-xai-grok-api-key

# Default LLM Provider: auto | openai | anthropic | deepseek | grok
DEFAULT_LLM_PROVIDER=auto

# Background Redis Queue (Local fallback or Render Cloud Redis URL: rediss://...)
REDIS_URL=redis://localhost:6379/0
